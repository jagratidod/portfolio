# Copy to .env (never commit .env). Only VITE_* vars are exposed to the browser.
VITE_CONTACT_EMAIL=you@example.com
VITE_GITHUB_URL=https://github.com/your-handle
VITE_LINKEDIN_URL=https://www.linkedin.com/in/your-handle
VITE_RESUME_URL=/resume.pdf
# Optional: Formspree/Getform endpoint. If empty, the contact form opens the visitor's mail app.
VITE_FORM_ENDPOINT=
